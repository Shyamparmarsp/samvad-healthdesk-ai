{
  "name": "samvad-healthdesk-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/contract-regression.test.ts tests/patient-flow.test.ts tests/doctor-flow.test.ts tests/supabase-mode.test.ts tests/local-supabase-journey.test.ts tests/api/patient-journey.test.ts tests/api/safety-and-adaptive.test.ts tests/api/contract-and-authorisation.test.ts",
    "test:mock": "tsx --test tests/contract-regression.test.ts tests/patient-flow.test.ts tests/doctor-flow.test.ts",
    "test:supabase": "tsx --test tests/supabase-mode.test.ts tests/local-supabase-journey.test.ts",
    "test:api": "tsx --test tests/api/patient-journey.test.ts tests/api/safety-and-adaptive.test.ts tests/api/contract-and-authorisation.test.ts",
    "test:api:journey": "tsx --test tests/api/patient-journey.test.ts",
    "test:api:safety": "tsx --test tests/api/safety-and-adaptive.test.ts",
    "test:api:contract": "tsx --test tests/api/contract-and-authorisation.test.ts",
    "test:e2e": "node tests/verify-interactions.mjs",
    "test:api:browser": "node tests/api/browser/supabase-journey.mjs",
    "test:api:browser:extras": "node tests/api/browser/supabase-extras.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
