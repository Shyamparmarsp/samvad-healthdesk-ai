# Samvad HealthDesk AI — environment configuration TEMPLATE
# Copy to `.env.local` (frontend) or use for reference. Names only; never commit values.
# Every `.env*` file except this one is git-ignored.

# ---------------------------------------------------------------------------
# Frontend (Vite, public — baked into the browser bundle)
# ---------------------------------------------------------------------------
# Public Supabase API URL, e.g. http://127.0.0.1:54321 (local) or
# https://<project-ref>.supabase.co (production). Never put a secret here.
VITE_SUPABASE_URL=

# Public client key: the publishable key (sb_publishable_…) or the legacy anon key.
# NEVER the secret/service-role key.
VITE_SUPABASE_KEY=

# ---------------------------------------------------------------------------
# Supabase Edge Function Secrets (server-side only; set with `supabase secrets set`)
# ---------------------------------------------------------------------------
# Groq reasoning (department suggestion + adaptive question selection).
GROQ_API_KEY=

# Gnani API key, used for both Prisma (STT) and Timbre (TTS).
GNANI_API_KEY=

# Comma-separated exact browser origins allowed by _shared/cors.ts, no wildcard.
# Example shape: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=

# Optional provider endpoint overrides. Leave empty in normal operation so the verified
# production endpoints in _shared/*.ts are used. Only set these for a local stub.
GROQ_BASE_URL=
PRISMA_BASE_URL=
TIMBRE_ENDPOINT=

# ---------------------------------------------------------------------------
# LOCAL TEST ONLY — never set these in Vercel or in a deployed function
# ---------------------------------------------------------------------------
# Local stack keys, used by the test suites and operational scripts.
# `npx supabase status -o env` prints them for the local stack only.
LOCAL_SERVICE_KEY=
LOCAL_ANON_KEY=
